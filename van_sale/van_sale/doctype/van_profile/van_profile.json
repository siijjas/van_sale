   "fieldtype": "Currency",
   "label": "Variance Tolerance",
   "depends_on": "eval:doc.use_shifts",
   "description": "A closing whose counted cash differs from expected by more than this is flagged Exceeds Tolerance on the closing and the manager dashboard. 0 flags any difference. Never blocks closing."
  },
  {
   "fieldname": "hide_expected_amount",
   "fieldtype": "Check",
   "label": "Blind Cash Count",
   "default": "0",
   "depends_on": "eval:doc.use_shifts",
   "description": "Hide the expected amounts on the closing screen so staff count the drawer without knowing the target. Managers closing a shift still see them."
  },
  {
   "fieldname": "allow_driver_close_shift",
   "fieldtype": "Check",
   "label": "Staff Can Close Their Own Shift",
